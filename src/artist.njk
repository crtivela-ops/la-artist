---
layout: base.njk
pageType: artist
pagination: { data: groups.artists, size: 1, alias: x }
permalink: "/artist/{{ x.slug }}/"
eleventyComputed:
  title: "{{ x.name | safe }}"
  description: "{{ x.seoDescription | safe }}"
  ogImage: "/assets/art/{{ x.items[0].id }}.webp"
  ogImageWidth: "{{ x.items[0].w }}"
  ogImageHeight: "{{ x.items[0].h }}"
  ogImageAlt: "ArtCard by {{ x.items[0].artist | safe }}"
  shareTitle: "ArtCards by {{ x.name | safe }}"
  shareText: "ArtCards by {{ x.name | safe }} on ArtCard.LA"
---
<div data-pagefind-body>
<p class="crumbs" data-pagefind-ignore><a href="{{ '/artists/' | url }}">Artists</a></p>
<h1 data-pagefind-meta="title">{{ x.name }}</h1>
<p class="lede">{{ x.items.length | plural('ArtCard') }}{% if x.zips.length %} · ZIP {% for z in x.zips %}<a href="{{ ('/zip/' + z + '/') | url }}">{{ z }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
{% set items = x.items %}
{% include "share.njk" %}{% include "grid.njk" %}
</div>
