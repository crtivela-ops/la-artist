---
layout: base.njk
pagination: { data: groups.zips, size: 1, alias: z }
permalink: "/zip/{{ z.zip }}/"
eleventyComputed:
  title: "ZIP {{ z.zip | safe }}"
  description: "{{ z.items.length | safe }} ArtCards mailed from ZIP code {{ z.zip | safe }}."
  ogImage: "/assets/art/{{ z.items[0].id }}.webp"
  ogImageWidth: "{{ z.items[0].w }}"
  ogImageHeight: "{{ z.items[0].h }}"
  ogImageAlt: "ArtCard by {{ z.items[0].artist | safe }}"
  shareTitle: "ArtCards from ZIP {{ z.zip | safe }}"
  shareText: "ArtCards from ZIP {{ z.zip | safe }} on ArtCard.LA"
---
<div data-pagefind-body>
<p class="crumbs" data-pagefind-ignore><a href="{{ '/zips/' | url }}">ZIP codes</a>{% if not z.inLA %} · <a href="{{ '/region/outside-la/' | url }}">outside LA County</a>{% endif %}</p>
<h1>ZIP {{ z.zip }}</h1>
<p class="lede">{{ z.items.length | plural('ArtCard') }}{% if z.neighborhoods.length %} · {% for n in z.neighborhoods %}<a href="{{ ('/neighborhood/' + n.slug + '/') | url }}">{{ n.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}{% if not z.inLA %} · outside Los Angeles County{% endif %}</p>
{% set items = z.items %}
{% include "share.njk" %}{% set showZip = false %}{% include "grid.njk" %}
</div>
