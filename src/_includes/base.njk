<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-QTS73YMS6C"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-QTS73YMS6C');
</script>
{%- set metaDesc = description or 'ArtCard.LA is a finished public archive of 1,372 postcards by 746 artists mailed across Los Angeles from 2009–2015. Submissions are closed.' %}
{%- set metaTitle = (title + ' · ArtCard.LA') if title else 'ArtCard.LA' %}
{%- set metaImage = siteUrl + ((ogImage or '/assets/og/default.jpg') | url) %}
<title>{{ metaTitle | e }}</title>
<meta name="description" content="{{ metaDesc | e }}">
{%- if robots %}<meta name="robots" content="{{ robots | e }}">{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
<link rel="canonical" href="{{ siteUrl }}{{ page.url | url }}">
<meta property="og:site_name" content="ArtCard.LA">
<meta property="og:title" content="{{ metaTitle | e }}">
<meta property="og:url" content="{{ siteUrl }}{{ page.url | url }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:description" content="{{ metaDesc | e }}">
<meta property="og:image" content="{{ metaImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:alt" content="{{ (ogImageAlt if ogImage else 'ArtCard: Los Angeles, one postcard at a time') | e }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle | e }}">
<meta name="twitter:description" content="{{ metaDesc | e }}">
<meta name="twitter:image" content="{{ metaImage }}">
<meta name="twitter:image:alt" content="{{ (ogImageAlt if ogImage else 'ArtCard: Los Angeles, one postcard at a time') | e }}">
<link rel="icon" href="{{ '/assets/favicon.png' | url }}">
{%- if pageType == "home" and homepage.hero[0] %}
{%- set h = homepage.hero[0] %}
<link rel="preload" as="image" href="{{ ('/assets/art/' + h.id + '.webp') | url }}" imagesrcset="{{ ('/assets/art/' + h.id + '-400.webp') | url }} 400w, {{ ('/assets/art/' + h.id + '.webp') | url }} {{ h.w }}w" imagesizes="(max-width: 1200px) calc(100vw - 32px), 1168px" fetchpriority="high">
{%- endif %}
{%- if pageType == "artwork" %}
<script type="application/ld+json">{{ a.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "artist" %}
<script type="application/ld+json">{{ x.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "neighborhood" %}
<script type="application/ld+json">{{ n.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "zip" %}
<script type="application/ld+json">{{ z.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "region" %}
<script type="application/ld+json">{{ r.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "books" %}
<script type="application/ld+json">{{ bookJsonLd | seoGraph | safe }}</script>
{%- elif pageType == "home" %}
<script type="application/ld+json">{{ groups.stats | homeJsonLd | seoGraph | safe }}</script>
{%- else %}
<script type="application/ld+json">{{ null | seoGraph | safe }}</script>
{%- endif %}
<script>document.documentElement.classList.add("js");</script>
<script src="{{ '/assets/js/nav.js' | url }}" defer></script>
{% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="top-bar">
    <div class="brand">
      <div class="brand-mark">
        <a class="logo wordmark" href="{{ '/' | url }}" aria-label="ArtCard.LA home"><img src="{{ '/assets/artcard-wordmark.png' | url }}" width="280" height="65" alt=""></a>
        <p class="formerly">formerly LA-Artist.com</p>
      </div>
      <a class="top-ig" href="https://www.instagram.com/artcard.la/" target="_blank" rel="noopener" aria-label="ArtCard.LA on Instagram"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg><span class="top-ig-label" aria-hidden="true">@artcard.la</span></a>
    </div>
    <button class="nav-toggle" type="button" id="nav-toggle" aria-expanded="false" aria-controls="site-menu">
      <svg class="nav-toggle-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path class="nav-icon-menu" d="M4 7h16M4 12h16M4 17h16"/>
        <path class="nav-icon-close" d="M6 6l12 12M18 6L6 18"/>
      </svg>
      <span class="nav-toggle-label">Menu</span>
    </button>
  </div>
  <nav class="nav" id="site-menu" aria-label="Main">
    <ul class="nav-list">
      <li>
        <span class="nav-label" id="nav-explore-label">Explore</span>
        <ul class="nav-sub" aria-labelledby="nav-explore-label">
          <li><a href="{{ '/map/' | url }}">Map</a></li>
          <li><a href="{{ '/zips/' | url }}">ZIP codes</a></li>
          <li><a href="{{ '/neighborhoods/' | url }}">Neighborhoods</a></li>
        </ul>
      </li>
      <li><a href="{{ '/artists/' | url }}">Artists</a></li>
      <li><a href="{{ '/search/' | url }}">Search</a></li>
      <li>
        <a href="{{ '/about/' | url }}">About</a>
        <ul class="nav-sub">
          <li><a href="{{ '/contact/' | url }}">Contact</a></li>
          <li><a href="{{ '/books/' | url }}">Books</a></li>
        </ul>
      </li>
    </ul>
    <ul class="nav-list nav-secondary">
      <li><a class="ig" href="https://www.instagram.com/artcard.la/"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>Instagram</a></li>
    </ul>
  </nav>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="foot">
  <p>ArtCard.LA (formerly LA-Artist.com) · ArtCard, a mail art project from Los Angeles, 2009–2015. All artworks © their artists.</p>
  <p class="foot-contact"><a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a></p>
  <p><a href="https://www.instagram.com/artcard.la/">Instagram</a> · <a href="{{ '/books/' | url }}">Books</a> · <a href="{{ '/about/' | url }}">About the archive</a> · <a class="foot-kofi" href="{{ site.kofiUrl }}"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h11v7a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4V8z"/><path d="M16 10h1.5a2.5 2.5 0 1 1 0 5H16"/><path d="M8 3s.5 1.2.5 2.2S8 7 8 7M12 3s.5 1.2.5 2.2S12 7 12 7"/></svg>Support the archive</a> · <a href="{{ '/contact/' | url }}">Contact</a> · <a href="{{ '/region/outside-la/' | url }}">Outside LA</a> · <a href="{{ '/region/us-states/' | url }}">U.S. States</a> · <a href="{{ '/region/international/' | url }}">International</a> · <a href="{{ '/region/unknown/' | url }}">Unknown</a></p>
  <p class="foot-donate">Donations help cover the domain, hosting, and basic maintenance so the collection and map remain freely available.</p>
  <p class="legalnav"><a href="{{ '/terms-of-use/' | url }}">Terms of Use</a> · <a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a> · <a href="{{ '/refunds/' | url }}">Refunds and Returns</a></p>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
