<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set metaDesc = description or 'An archive of ArtCards: postcard-sized artworks mailed in from across Los Angeles County, organized by ZIP code.' %}
{%- set metaTitle = (title + ' · ArtCard.LA') if title else 'ArtCard.LA' %}
{%- set metaImage = siteUrl + ((ogImage or '/assets/og-default.png') | url) %}
<title>{{ metaTitle | e }}</title>
<meta name="description" content="{{ metaDesc | e }}">
{%- if robots %}<meta name="robots" content="{{ robots | e }}">{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
<link rel="canonical" href="{{ siteUrl }}{{ page.url | url }}">
<meta property="og:site_name" content="ArtCard.LA">
<meta property="og:title" content="{{ metaTitle | e }}">
<meta property="og:url" content="{{ siteUrl }}{{ page.url | url }}">
<meta property="og:type" content="website">
<meta property="og:description" content="{{ metaDesc | e }}">
<meta property="og:image" content="{{ metaImage }}">
<meta property="og:image:width" content="{{ ogImageWidth if ogImage else 1200 }}">
<meta property="og:image:height" content="{{ ogImageHeight if ogImage else 630 }}">
<meta property="og:image:alt" content="{{ (ogImageAlt if ogImage else 'ArtCard: Los Angeles, one postcard at a time') | e }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle | e }}">
<meta name="twitter:description" content="{{ metaDesc | e }}">
<meta name="twitter:image" content="{{ metaImage }}">
<meta name="twitter:image:alt" content="{{ (ogImageAlt if ogImage else 'ArtCard: Los Angeles, one postcard at a time') | e }}">
<link rel="icon" href="{{ '/assets/favicon.png' | url }}">
{%- if pageType == "artwork" %}
<script type="application/ld+json">{{ a.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "artist" %}
<script type="application/ld+json">{{ x.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "neighborhood" %}
<script type="application/ld+json">{{ n.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "zip" %}
<script type="application/ld+json">{{ z.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "region" %}
<script type="application/ld+json">{{ r.jsonLd | seoGraph | safe }}</script>
{%- elif pageType == "books" %}
<script type="application/ld+json">{{ bookJsonLd | seoGraph | safe }}</script>
{%- elif pageType == "home" %}
<script type="application/ld+json">{{ groups.stats | homeJsonLd | seoGraph | safe }}</script>
{%- else %}
<script type="application/ld+json">{{ null | seoGraph | safe }}</script>
{%- endif %}
{% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <a class="logo wordmark" href="{{ '/' | url }}" aria-label="ArtCard.LA home"><img src="{{ '/assets/artcard-wordmark.png' | url }}" width="280" height="65" alt=""></a>
  <p class="formerly">formerly LA-Artist.com</p>
  <nav class="nav" aria-label="Main">
    <a href="{{ '/map/' | url }}">Map</a>
    <a href="{{ '/zips/' | url }}">ZIP codes</a>
    <a href="{{ '/neighborhoods/' | url }}">Neighborhoods</a>
    <a href="{{ '/artists/' | url }}">Artists</a>
    <a href="{{ '/search/' | url }}">Search</a>
    <a href="{{ '/books/' | url }}">Books</a>
    <a href="{{ '/about/' | url }}">About</a>
    <a href="{{ '/contact/' | url }}">Contact</a>
    <a class="ig" href="https://www.instagram.com/artcard.la/"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>@artcard.la</a>
  </nav>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="foot">
  <p>ArtCard.LA (formerly LA-Artist.com) · ArtCard, a mail art project from Los Angeles, 2009–2015. All artworks © their artists.</p>
  <p class="foot-contact">{{ site.addressLine }} · <a href="tel:{{ site.phoneTel }}">{{ site.phoneDisplay }}</a> · <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a></p>
  <p><a href="https://www.instagram.com/artcard.la/">Instagram @artcard.la</a> · <a href="{{ '/books/' | url }}">Books</a> · <a href="{{ '/about/' | url }}">About the archive</a> · <a href="{{ '/contact/' | url }}">Contact</a> · <a href="{{ '/region/outside-la/' | url }}">Outside LA</a> · <a href="{{ '/region/us-states/' | url }}">U.S. States</a> · <a href="{{ '/region/international/' | url }}">International</a> · <a href="{{ '/region/unknown/' | url }}">Unknown</a></p>
  <p class="legalnav"><a href="{{ '/terms-of-use/' | url }}">Terms of Use</a> · <a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a> · <a href="{{ '/refunds/' | url }}">Refunds and Returns</a></p>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
