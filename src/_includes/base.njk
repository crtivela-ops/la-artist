<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}ArtCard.LA</title>
<meta name="description" content="{{ description or 'An archive of ArtCards: postcard-sized artworks mailed in from across Los Angeles County, organized by ZIP code.' }}">
<link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
<link rel="canonical" href="{{ siteUrl }}{{ page.url | url }}">
<meta property="og:site_name" content="ArtCard.LA">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}ArtCard.LA">
<meta property="og:url" content="{{ siteUrl }}{{ page.url | url }}">
<meta property="og:type" content="website">
{%- set metaDesc = description or 'An archive of ArtCards: postcard-sized artworks mailed in from across Los Angeles County, organized by ZIP code.' %}
{%- set metaTitle = (title + ' · ArtCard.LA') if title else 'ArtCard.LA' %}
{%- set metaImage = siteUrl + ((ogImage or '/assets/og-default.png') | url) %}
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:image" content="{{ metaImage }}">
<meta property="og:image:width" content="{{ ogImageWidth if ogImage else 1200 }}">
<meta property="og:image:height" content="{{ ogImageHeight if ogImage else 630 }}">
<meta property="og:image:alt" content="{{ ogImageAlt if ogImage else 'ArtCard: Los Angeles, one postcard at a time' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle }}">
<meta name="twitter:description" content="{{ metaDesc }}">
<meta name="twitter:image" content="{{ metaImage }}">
<meta name="twitter:image:alt" content="{{ ogImageAlt if ogImage else 'ArtCard: Los Angeles, one postcard at a time' }}">
<link rel="icon" href="{{ '/assets/favicon.png' | url }}">
{% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <a class="logo wordmark" href="{{ '/' | url }}" aria-label="ArtCard.LA home"><img src="{{ '/assets/artcard-wordmark.png' | url }}" width="280" height="65" alt=""></a>
  <p class="formerly">formerly LA-Artist.com</p>
  <nav class="nav" aria-label="Main">
    <a href="{{ '/map/' | url }}">Map</a>
    <a href="{{ '/zips/' | url }}">ZIP codes</a>
    <a href="{{ '/neighborhoods/' | url }}">Neighborhoods</a>
    <a href="{{ '/artists/' | url }}">Artists</a>
    <a href="{{ '/search/' | url }}">Search</a>
    <a href="{{ '/books/' | url }}">Books</a>
    <a href="{{ '/about/' | url }}">About</a>
  </nav>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="foot">
  <p>ArtCard.LA (formerly LA-Artist.com) · ArtCard, a mail art project from Los Angeles, 2009–2015. All artworks © their artists.</p>
  <p><a href="{{ '/books/' | url }}">Books</a> · <a href="{{ '/about/' | url }}">About the archive</a> · <a href="{{ '/region/outside-la/' | url }}">Outside LA</a> · <a href="{{ '/region/us-states/' | url }}">U.S. States</a> · <a href="{{ '/region/international/' | url }}">International</a> · <a href="{{ '/region/unknown/' | url }}">Unknown</a></p>
  <p class="legalnav"><a href="{{ '/terms-of-use/' | url }}">Terms of Use</a> · <a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a></p>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
