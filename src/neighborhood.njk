---
layout: base.njk
pagination: { data: groups.neighborhoods, size: 1, alias: n }
permalink: "/neighborhood/{{ n.slug }}/"
eleventyComputed:
  title: "{{ n.name | safe }}"
  description: "{{ n.items.length | safe }} ArtCards from {{ n.name | safe }}."
  ogImage: "/assets/art/{{ n.items[0].id }}.webp"
  ogImageWidth: "{{ n.items[0].w }}"
  ogImageHeight: "{{ n.items[0].h }}"
  ogImageAlt: "ArtCard by {{ n.items[0].artist | safe }}"
  shareTitle: "ArtCards from {{ n.name | safe }}"
  shareText: "ArtCards from {{ n.name | safe }} on ArtCard.LA"
---
<div data-pagefind-body>
<p class="crumbs" data-pagefind-ignore><a href="{{ '/neighborhoods/' | url }}">Neighborhoods</a></p>
<h1>{{ n.name }}</h1>
<p class="lede">{{ n.items.length | plural('ArtCard') }}{% if n.zips.length %} · ZIP {% for z in n.zips %}<a href="{{ ('/zip/' + z + '/') | url }}">{{ z }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
{% set items = n.items %}
{% include "share.njk" %}{% include "grid.njk" %}
</div>
